# Shortcut globale per parlare con Rick
RICK_HOTKEY=alt+r

# Lingua di Rick: "it" o "en". Se la lasci vuota, la finestra al primo avvio
# te la chiede e la ricorda da sola (nessun bisogno di editare questo file).
RICK_LANGUAGE=

# Facoltativa: chiave gratuita per il "cervello" di Rick (Google Gemini).
# Se la lasci vuota, al primo avvio Rick apre una finestra che la chiede e
# la salva da solo (comodo se condividi il progetto con altre persone).
# Creala su https://aistudio.google.com/apikey (nessuna carta di credito richiesta)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Facoltativa: chiave gratuita Tavily, per far cercare a Rick sul web (wiki,
# guide) prima di risponderti - piu' preciso su oggetti/missioni specifiche.
# Se la lasci vuota (o non la inserisci nella finestra al primo avvio),
# Rick risponde comunque, solo dalla sua conoscenza di base.
# Creala su https://app.tavily.com (nessuna carta di credito richiesta)
TAVILY_API_KEY=
RICK_ENABLE_WEB_SEARCH=true

# Riconoscimento vocale: sempre in locale sul tuo PC (gratis, offline dopo
# il download iniziale del modello).
# Piu' grande = capisce meglio ma e' piu' lento: tiny < base < small < medium.
# "small" e' un buon compromesso su PC normali; su PC piu' lenti prova "base".
# Se Rick capisce male quello che dici e il tuo PC e' abbastanza potente,
# prova "medium": molto piu' preciso, ma ogni domanda impiega qualche
# secondo in piu' a essere trascritta.
RICK_WHISPER_MODEL_SIZE=small
# Se hai una scheda video Nvidia con CUDA/cuDNN installati, "cuda" rende la
# trascrizione molto piu' veloce a parita' di precisione. Se non sono
# installati (o qualcosa non va), Rick se ne accorge da solo e torna alla
# CPU senza bloccarsi.
RICK_WHISPER_DEVICE=cpu

# Voce di Rick: le voci online di Microsoft Edge (gratis, nessuna chiave).
# Lascia vuoto per usare la voce di default in base a RICK_LANGUAGE
# (it-IT-ElsaNeural per l'italiano, en-US-JennyNeural per l'inglese - entrambe
# voci femminili adulte, circa 25-30 anni). Imposta un valore per forzarne
# un'altra (es. it-IT-IsabellaNeural, piu' giovanile/da bambina).
RICK_EDGE_VOICE=
RICK_EDGE_PITCH=+0Hz
RICK_EDGE_RATE=+0%

# Memoria di Rick. Quanti messaggi recenti della conversazione in corso
# ricorda (domande + risposte):
RICK_MAX_HISTORY_TURNS=12
# Quante risposte gia' date per il gioco attuale (anche in sessioni passate)
# rilegge prima di rispondere. Meno = richieste un po' piu' leggere e veloci;
# 0 = spegne questa memoria.
RICK_MAX_SAVED_HISTORY_ENTRIES=10
